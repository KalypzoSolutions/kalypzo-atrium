{
	"name": "@kalypzo/atrium",
	"private": true,
	"version": "2.0.0-pre.2",
	"license": "Apache-2.0",
	"author": "Philipp Hethey",
	"type": "module",
	"engines": {
		"bun": ">=1.4.4"
	},
	"packageManager": "bun@1.4.4",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "bun ./build/index.js",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check . && bun tools/module-boundaries.ts",
		"format": "biome check --write .",
		"test": "ATRIUM_MODULES_DIR=tests/fixtures/modules bun scripts/test.mjs",
		"test:unit": "ATRIUM_MODULES_DIR=tests/fixtures/modules bun scripts/test.mjs ./tests/unit",
		"test:integration": "ATRIUM_MODULES_DIR=tests/fixtures/modules bun scripts/test.mjs ./tests/integration",
		"test:core": "ATRIUM_MODULES_DIR=tests/fixtures/modules bun scripts/test.mjs",
		"check:core": "ATRIUM_MODULES_DIR=tests/fixtures/modules bun run check",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"openapi": "ATRIUM_MODULES_DIR=tests/fixtures/modules WRITE_OPENAPI=1 bun scripts/test.mjs ./tests/unit/openapi.test.ts",
		"test:coverage": "ATRIUM_MODULES_DIR=tests/fixtures/modules bun scripts/test.mjs --coverage",
		"test:e2e:install": "playwright test -c playwright.install.config.ts",
		"playwright": "playwright",
		"biome": "biome",
		"test:modules": "bun scripts/test.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.9",
		"@electric-sql/pglite": "^0.5.8",
		"@electric-sql/pglite-socket": "^0.2.11",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.5",
		"@types/node": "^26.6.5",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@types/sanitize-html": "^2.16.2",
		"@types/semver": "^7.8.0",
		"@types/web-push": "3.6.4",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^9.1.0",
		"@aws-sdk/client-s3": "^3.1149.0",
		"@aws-sdk/lib-storage": "^3.1149.0",
		"@aws-sdk/s3-request-presigner": "^3.1149.0",
		"@lucide/svelte": "^1.55.0",
		"@napi-rs/canvas": "1.0.11",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-image": "3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"barcode-detector": "^3.2.3",
		"better-auth": "^1.7.7",
		"bits-ui": "^2.19.5",
		"bwip-js": "^4.11.4",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"fflate": "^0.8.3",
		"nodemailer": "^10.1.0",
		"openai": "^7.32.0",
		"pdf-lib": "1.17.1",
		"pdfjs-dist": "6.4.299",
		"pg": "^8.23.1",
		"playwright": "^1.64.0",
		"qrcode": "^1.5.4",
		"sanitize-html": "^2.18.1",
		"semver": "^7.8.5",
		"sharp": "^0.35.5",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"web-push": "3.6.7",
		"zod": "^4.6.6"
	}
}
