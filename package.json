{
	"name": "ep-intern",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"openapi": "cross-env WRITE_OPENAPI=1 vitest run tests/unit/openapi.test.ts"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@electric-sql/pglite-socket": "^0.2.11",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.4",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "^1.5.6",
		"@vitest/coverage-v8": "^5.0.3",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.12.0",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"svelte-eslint-parser": "^1.9.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^9.1.0",
		"@aws-sdk/client-s3": "^3.1149.0",
		"@aws-sdk/lib-storage": "^3.1149.0",
		"@aws-sdk/s3-request-presigner": "^3.1149.0",
		"@lucide/svelte": "^1.55.0",
		"better-auth": "^1.7.7",
		"bits-ui": "^2.19.5",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.4",
		"fflate": "^0.8.3",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^10.1.0",
		"openai": "^7.32.0",
		"pdf-lib": "1.17.1",
		"pg": "^8.23.1",
		"playwright": "^1.64.0",
		"qrcode": "^1.5.4",
		"sharp": "^0.35.5",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"zod": "^4.6.5"
	}
}
