# Vorlage für den Reiter "Environment" in Dokploy (docker-compose.dokploy-external-s3.yml). Niemals committen.
# Variante mit EXTERNEM S3-Speicher (kein MinIO im Stack).
# ALLE Secrets zufällig erzeugen (keine Wörter, nie wiederverwenden):
#   openssl rand -hex 24        → Passwörter
#   openssl rand -base64 48     → APP_SECRET

# --- Umgebung --------------------------------------------------------------------------------
# Je Dokploy-Stack verschieden (z. B. prod und staging). Daraus entstehen die internen Dienstnamen
# ep-intern-<DEPLOY_ENV>-app|db|website. Nur Kleinbuchstaben, Ziffern und Bindestrich.
DEPLOY_ENV=prod

# --- Pflicht ---------------------------------------------------------------------------------
# Öffentliche URL exakt so, wie sie im Browser steht (https, ohne Slash am Ende; http bricht den Start ab)
ORIGIN=https://intern.example.org
# Mindestens 32 Zeichen, zufällig. ACHTUNG: Nach dem ersten Start nicht mehr ändern (verschlüsselte
# Einstellungen und IBANs wären sonst unlesbar). Sicher separat sichern!
APP_SECRET=
POSTGRES_PASSWORD=

# --- Externer S3-Speicher (Pflicht) ------------------------------------------------------------
# Bucket privat anlegen; Zugangsschlüssel beim Anbieter nur mit Rechten auf DIESEN Bucket erzeugen
# (Lesen, Schreiben, Löschen, Auflisten). Die Werte werden nur beim ersten Start in die Einstellungen
# übernommen – spätere Änderungen unter Administration → Einstellungen → Speicher.
# Beispiele:
#   Hetzner Object Storage: S3_ENDPOINT=https://fsn1.your-objectstorage.com  S3_REGION=fsn1
#   Cloudflare R2:          S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#   Backblaze B2:           S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com  S3_REGION=eu-central-003
#   AWS S3:                 S3_ENDPOINT leer lassen, S3_REGION=eu-central-1
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true nur, wenn der Anbieter keine virtuellen Host-Namen (bucket.endpoint) kann, z. B. eigener MinIO/Garage
# S3_FORCE_PATH_STYLE=false

# --- Erster Start ----------------------------------------------------------------------------
# Legt den ersten Administrator an, falls noch keiner existiert (Passwort >= 12 Zeichen).
# Danach beide Variablen entfernen (das Passwort bleibt sonst in der Container-Umgebung sichtbar).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Automatische Sicherung (Dienst db-backup) -----------------------------------------------------
# Aktivieren: COMPOSE_PROFILES=backup. Dokploy-Backups sichern die `db` dieses Stacks NICHT.
# Der Bucket wird standardmäßig mit dem App-Zugang (S3_*) mitgesichert; besser einen Nur-Lese-Schlüssel
# über BACKUP_S3_ACCESS_KEY_ID/BACKUP_S3_SECRET_ACCESS_KEY setzen. Bei AWS (S3_ENDPOINT leer) muss
# BACKUP_S3_ENDPOINT gesetzt werden (z. B. https://s3.eu-central-1.amazonaws.com), sonst nur die Datenbank.
# COMPOSE_PROFILES=backup
# Schlüssel des Sicherungs-Repositorys (openssl rand -base64 32), getrennt vom Server aufbewahren!
# RESTIC_PASSWORD=
# Ziel außerhalb des Servers – NICHT derselbe Bucket wie S3_BUCKET (eigener Bucket, möglichst anderer Anbieter/Standort)
# RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/ep-intern-backup
# BACKUP_REPO_ACCESS_KEY_ID=
# BACKUP_REPO_SECRET_ACCESS_KEY=
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_TIME=02:30
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/<uuid>
# BACKUP_NOTIFY_URL=https://ntfy.sh/<geheimes-thema>
# TZ=Europe/Berlin

# --- Optional / Standardwerte ------------------------------------------------------------------
# POSTGRES_DB=ep_intern
# POSTGRES_USER=ep_intern

# Ressourcen (Standard für 4 GB RAM / ab 1 vCPU; Empfehlungen in docs/deployment.md → „Ressourcen und Logs“)
# APP_MEM_LIMIT=1536m
# APP_CPUS=1.0
# DB_MEM_LIMIT=1g
# WEBSITE_MEM_LIMIT=256m
# BACKUP_MEM_LIMIT=512m
# Größte hochladbare Sicherungsdatei in Byte (Standard 4 GB)
# BACKUP_MAX_BYTES=4294967296

# E-Mail-Versand (Bestätigungs-Mails der Anmeldung, Passwort vergessen)
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=EP Intern <noreply@example.org>

# Stammeswebsite (Service `website`, Domain in Dokploy auf website:3001)
# WEBSITE_ORIGIN=https://edelweisspiraten-bremen.de
# API-Key aus Administration -> API-Keys mit den Scopes
# events.website.read galleries.website.read members.website.read
# WEBSITE_API_KEY=epk_...

# Maximale DB-Verbindungen der App (Standard 10)
# DATABASE_POOL_MAX=10

# Stammeswebsite: Kontaktformular per SMTP an EINE feste Adresse (#31). Leer = Formular meldet 503.
CONTACT_TO=
WEBSITE_SMTP_HOST=
WEBSITE_SMTP_PORT=587
WEBSITE_SMTP_SECURE=false
WEBSITE_SMTP_USER=
WEBSITE_SMTP_PASS=
WEBSITE_SMTP_FROM=
