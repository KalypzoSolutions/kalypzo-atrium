# Kopieren nach .env und Werte setzen. Niemals committen.

# --- PostgreSQL ---
POSTGRES_DB=ep_intern
POSTGRES_USER=ep_intern
POSTGRES_PASSWORD=

# --- Anwendung ---
# Oeffentliche URL (mit https:// hinter dem Reverse Proxy)
ORIGIN=https://intern.example.org
# Mindestens 32 Zeichen, zufaellig: openssl rand -base64 48
# ACHTUNG: Eine Aenderung macht verschluesselte Einstellungen (Secrets) unlesbar.
APP_SECRET=
# Optionaler Port-Bind auf 127.0.0.1
APP_PORT=3000
# Maximale Datenbankverbindungen der Anwendung (Standard 10)
# DATABASE_POOL_MAX=10

# Nur beim ersten Start: legt einen Administrator an, falls noch keiner existiert.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Lokale Entwicklung (npm run dev, docker-compose.dev.yml) ---
# DATABASE_URL=postgres://ep_intern:dev-password@localhost:5432/ep_intern
