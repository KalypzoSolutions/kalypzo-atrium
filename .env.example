# Kopieren nach .env und Werte setzen. Niemals committen.
# Zufallswerte: openssl rand -hex 24  (bzw. für APP_SECRET openssl rand -base64 48)
# Alle Secrets ZUFÄLLIG erzeugen – keine Wörter, keine wiederverwendeten Passwörter.

# --- PostgreSQL ---
POSTGRES_DB=ep_intern
POSTGRES_USER=ep_intern
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Anwendung ---
# Öffentliche URL, im Produktivbetrieb Pflicht und mit https:// (Start bricht sonst ab)
ORIGIN=https://intern.example.org
# Mindestens 32 Zeichen, zufällig: openssl rand -base64 48
# ACHTUNG: Eine Änderung macht verschlüsselte Einstellungen (Secrets) unlesbar.
APP_SECRET=
# Optionaler Port-Bind auf 127.0.0.1
APP_PORT=3000
# Maximale Datenbankverbindungen der Anwendung (Standard 10)
# DATABASE_POOL_MAX=10
# Größte hochladbare Sicherungsdatei in Byte (Standard 4 GB); Volume `backup-tmp` braucht ≈ 2× so viel Platz
# BACKUP_MAX_BYTES=4294967296

# Nur beim ersten Start: legt einen Administrator an, falls noch keiner existiert.
# Danach beide Werte wieder leeren (sonst bleibt das Passwort in der Container-Umgebung sichtbar).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Profile: proxy (nginx), backup (automatische Sicherung) ---
# COMPOSE_PROFILES=proxy,backup
# Domain des Intern-Bereichs für nginx (Profil proxy); andere Hosts werden abgewiesen
# INTERN_DOMAIN=intern.example.org

# --- Ressourcen (Standard für 4 GB RAM; Werte und 2-GB-Empfehlung in docs/deployment.md) ---
# APP_MEM_LIMIT=1536m
# APP_CPUS=1.0
# DB_MEM_LIMIT=1g
# DB_CPUS=1.0
# WEBSITE_MEM_LIMIT=256m
# NGINX_MEM_LIMIT=128m
# BACKUP_MEM_LIMIT=512m

# --- Automatische Sicherung (Dienst db-backup, Profil backup) ---
# Schlüssel des restic-Repositorys (≥ 20 Zeichen, openssl rand -base64 32) – GETRENNT vom Server aufbewahren,
# ohne ihn ist keine Sicherung lesbar.
# RESTIC_PASSWORD=
# Ziel außerhalb des Hosts, z. B. s3:https://s3.eu-central-1.example.com/ep-intern-backup (Standard: Volume auf dem Host)
# RESTIC_REPOSITORY=/backups/restic
# BACKUP_REPO_ACCESS_KEY_ID=
# BACKUP_REPO_SECRET_ACCESS_KEY=
# BACKUP_TIME=02:30
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6
# Alarm: Heartbeat bei Erfolg (z. B. healthchecks.io), POST bei Fehler (z. B. ntfy-Thema)
# BACKUP_HEARTBEAT_URL=
# BACKUP_NOTIFY_URL=
# Objektspeicher, aus dem gesichert wird (Lesezugriff auf den App-Bucket genügt); leer = nur Datenbank
# BACKUP_S3_ENDPOINT=https://s3.example.com
# BACKUP_S3_BUCKET=ep-intern
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=

# --- Stammeswebsite (Service `website` in docker-compose.yml) ---
# Öffentliche Adresse der Website (Standard https://edelweisspiraten-bremen.de)
# WEBSITE_ORIGIN=https://edelweisspiraten-bremen.de
# API-Key aus Administration -> API-Keys mit den Scopes
# events.website.read galleries.website.read members.website.read offices.website.read website.content.read
# WEBSITE_API_KEY=epk_...
# Optionaler Port-Bind auf 127.0.0.1
# WEBSITE_PORT=3001

# --- Lokale Entwicklung (npm run dev, docker-compose.dev.yml) ---
# DATABASE_URL=postgres://ep_intern:dev-password@localhost:5432/ep_intern

# Stammeswebsite: Kontaktformular per SMTP an EINE feste Adresse (#31). Leer = Formular meldet 503.
CONTACT_TO=
WEBSITE_SMTP_HOST=
WEBSITE_SMTP_PORT=587
WEBSITE_SMTP_SECURE=false
WEBSITE_SMTP_USER=
WEBSITE_SMTP_PASS=
WEBSITE_SMTP_FROM=
