# Vorlage fuer den Reiter "Environment" in Dokploy (docker-compose.dokploy.yml). Niemals committen.
# Zufallswerte erzeugen: openssl rand -base64 48   (bzw. openssl rand -hex 24)

# --- Pflicht ---------------------------------------------------------------------------------
# Oeffentliche URL exakt so, wie sie im Browser steht (https, ohne Slash am Ende)
ORIGIN=https://intern.example.org
# Mindestens 32 Zeichen. ACHTUNG: Nach dem ersten Start nicht mehr aendern (verschluesselte
# Einstellungen und IBANs waeren sonst unlesbar). Sicher separat sichern!
APP_SECRET=
POSTGRES_PASSWORD=
# S3-Zugang (MinIO im Stack): Access-Key >= 3, Secret >= 8 Zeichen
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Erster Start ----------------------------------------------------------------------------
# Legt den ersten Administrator an, falls noch keiner existiert (Passwort >= 12 Zeichen).
# Danach koennen beide Variablen entfernt werden.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Optional / Standardwerte ------------------------------------------------------------------
# POSTGRES_DB=ep_intern
# POSTGRES_USER=ep_intern
# S3_BUCKET=ep-intern
# S3_REGION=us-east-1
# Externer S3 statt MinIO im Stack (z. B. Cloudflare R2, Hetzner): Service `storage` entfernen
# und hier Endpoint setzen; S3_FORCE_PATH_STYLE je nach Anbieter.
# S3_ENDPOINT=http://storage:9000
# S3_FORCE_PATH_STYLE=true

# E-Mail-Versand (Bestaetigungs-Mails der Anmeldung, Passwort vergessen)
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=EP Intern <noreply@example.org>

# Maximale DB-Verbindungen der App (Standard 10)
# DATABASE_POOL_MAX=10
