# Vorlage für den Reiter "Environment" in Dokploy (docker-compose.dokploy-external.yml). Niemals committen.
# Variante mit EXTERNEM PostgreSQL und EXTERNEM S3-Speicher (keine Datenbank, kein MinIO im Stack).
# ALLE Secrets zufällig erzeugen (keine Wörter, nie wiederverwenden):
#   openssl rand -hex 24        → Passwörter
#   openssl rand -base64 48     → APP_SECRET

# --- Umgebung --------------------------------------------------------------------------------
# Je Dokploy-Stack verschieden (z. B. prod und staging). Daraus entsteht der interne Dienstname
# ep-intern-<DEPLOY_ENV>-app. Nur Kleinbuchstaben, Ziffern und Bindestrich.
DEPLOY_ENV=prod

# --- Pflicht ---------------------------------------------------------------------------------
# Öffentliche URL exakt so, wie sie im Browser steht (https, ohne Slash am Ende; http bricht den Start ab)
ORIGIN=https://intern.example.org
# Mindestens 32 Zeichen, zufällig. ACHTUNG: Nach dem ersten Start nicht mehr ändern (verschlüsselte
# Einstellungen und IBANs wären sonst unlesbar). Sicher separat sichern!
APP_SECRET=

# --- Externes PostgreSQL (Pflicht) -------------------------------------------------------------
# Je Stack eigene Datenbank + eigener Benutzer (Besitzer der Datenbank), auf der zentralen Instanz anlegen:
#   CREATE ROLE atrium_prod LOGIN PASSWORD '<zufällig>';
#   CREATE DATABASE atrium_prod OWNER atrium_prod;
# Von Dokploy verwaltete Datenbank: Host = "Internal Host" aus Dokploy (im dokploy-network).
# Anderer Server: Hostname + ?sslmode=require (Zertifikat wird geprüft; selbst signiert: ?sslmode=no-verify).
# PgBouncer nur im Session-Modus.
# Sonderzeichen im Passwort URL-kodieren (@ → %40, : → %3A, / → %2F, # → %23).
DATABASE_URL=postgres://atrium_prod:PASSWORT@zentral-postgres-abc123:5432/atrium_prod
# Verbindungen dieser App (Standard 10); Summe aller Stacks unter max_connections der Instanz halten
# DATABASE_POOL_MAX=10

# --- Externer S3-Speicher (Pflicht) ------------------------------------------------------------
# Bucket privat anlegen; Zugangsschlüssel beim Anbieter nur mit Rechten auf DIESEN Bucket erzeugen
# (Lesen, Schreiben, Löschen, Auflisten). Die Werte werden nur beim ersten Start in die Einstellungen
# übernommen – spätere Änderungen unter Administration → Einstellungen → Speicher.
# Beispiele:
#   Hetzner Object Storage: S3_ENDPOINT=https://fsn1.your-objectstorage.com  S3_REGION=fsn1
#   Cloudflare R2:          S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#   Backblaze B2:           S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com  S3_REGION=eu-central-003
#   AWS S3:                 S3_ENDPOINT leer lassen, S3_REGION=eu-central-1
#   Zentraler MinIO/Garage: S3_ENDPOINT=https://s3.example.org  S3_REGION=us-east-1  S3_FORCE_PATH_STYLE=true
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true nur, wenn der Anbieter keine virtuellen Host-Namen (bucket.endpoint) kann, z. B. eigener MinIO/Garage
# S3_FORCE_PATH_STYLE=false
# Unterpfad im Bucket, wenn sich mehrere Installationen einen Bucket teilen (z. B. atrium/prod). Leer = Wurzel.
# Nur beim ersten Start übernommen; später unter Administration → Einstellungen → Speicher. Ein Wechsel
# verschiebt keine vorhandenen Dateien. Der Sicherungsdienst spiegelt dann nur diesen Pfad.
# S3_PREFIX=

# --- Erster Start ----------------------------------------------------------------------------
# Legt den ersten Administrator an, falls noch keiner existiert (Passwort >= 12 Zeichen).
# Danach beide Variablen entfernen (das Passwort bleibt sonst in der Container-Umgebung sichtbar).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# --- Automatische Sicherung (Dienst db-backup, optional) -------------------------------------------
# Meist übernimmt die zentrale Instanz die Sicherung (Dokploy-Backups der verwalteten Datenbank). Sonst:
# COMPOSE_PROFILES=backup
# Datenbankzugang für pg_dump (Lesezugriff genügt; pg_dump ist Version 17)
# BACKUP_PGHOST=zentral-postgres-abc123
# BACKUP_PGPORT=5432
# BACKUP_PGUSER=atrium_prod
# BACKUP_PGPASSWORD=
# BACKUP_PGDATABASE=atrium_prod
# BACKUP_PGSSLMODE=prefer
# Schlüssel des Sicherungs-Repositorys (openssl rand -base64 32), getrennt vom Server aufbewahren!
# RESTIC_PASSWORD=
# Ziel außerhalb des Servers – NICHT derselbe Bucket wie S3_BUCKET
# RESTIC_REPOSITORY=s3:https://fsn1.your-objectstorage.com/ep-intern-backup
# BACKUP_REPO_ACCESS_KEY_ID=
# BACKUP_REPO_SECRET_ACCESS_KEY=
# Bucket wird standardmäßig mit dem App-Zugang (S3_*) gespiegelt; besser Nur-Lese-Schlüssel:
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_TIME=02:30
# BACKUP_KEEP_DAILY=7
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6
# BACKUP_HEARTBEAT_URL=https://hc-ping.com/<uuid>
# BACKUP_NOTIFY_URL=https://ntfy.sh/<geheimes-thema>
# TZ=Europe/Berlin

# --- Optional / Standardwerte ------------------------------------------------------------------
# Ressourcen (Standard für 4 GB RAM / ab 1 vCPU; Empfehlungen in docs/deployment.md → „Ressourcen und Logs“)
# APP_MEM_LIMIT=4g
# APP_CPUS=1.0
# BACKUP_MEM_LIMIT=512m
# Größte hochladbare Sicherungsdatei in Byte (Standard 4 GB)
# BACKUP_MAX_BYTES=4294967296
# Modul-Installation im Panel: supervisor (Standard) | off
# ATRIUM_MODULE_INSTALL=supervisor

# E-Mail-Versand (Bestätigungs-Mails der Anmeldung, Passwort vergessen)
# SMTP_HOST=smtp.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Kalypzo Atrium <noreply@example.org>
